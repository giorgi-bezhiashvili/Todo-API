### ============================================
### JWT Auth + Tasks — REST Client test file
### Requires VS Code extension: humao.rest-client
### Server must be running: npm run start:dev
### ============================================

@baseUrl = http://localhost:3000

### 1. Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "testuser@example.com",
  "password": "password123"
}

### 2. Login -> returns accessToken + refreshToken
# Click "Send Request" above this block first, then copy the
# accessToken from the response into @token below.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "testuser",
  "password": "password123"
}

